Project ssulap {
  database_type: "PostgreSQL"
  Note: "써랍 데이터 모델. 기본 이력, 경험, 자소서, 문항별 검토 메모를 사용자 소유권 기준으로 관리한다."
}

Table users {
  id bigint [pk, increment]
  display_name varchar(50) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: "로그인 사용자와 개인 자료의 소유자를 식별한다. 검토 요청에서는 작성자와 검토자를 연결한다."
}

Table profiles {
  user_id bigint [pk]
  military_status varchar(30) [not null, default: 'UNSPECIFIED', note: 'UNSPECIFIED, NOT_APPLICABLE, NOT_SERVED, SERVING, COMPLETED, EXEMPT']
  military_branch varchar(50)
  military_rank varchar(50)
  military_start_month char(7)
  military_end_month char(7)
  veteran_status varchar(30) [not null, default: 'UNSPECIFIED', note: 'UNSPECIFIED, YES, NO']
  disability_status varchar(30) [not null, default: 'UNSPECIFIED', note: 'UNSPECIFIED, YES, NO']
  additional_info varchar(1000)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: '미입력과 비대상 구분. 민감 항목은 추천 입력에서 제외.'
}

Table educations {
  id bigint [pk, increment]
  user_id bigint [not null]
  school_name varchar(100) [not null]
  major varchar(100)
  education_status varchar(30) [not null, note: "Allowed: ENROLLED, ON_LEAVE, EXPECTED_GRADUATION, GRADUATED"]
  start_month char(7)
  end_month char(7)
  gpa decimal(5,2)
  gpa_scale decimal(5,2)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    user_id
  }
  Note: "gpa와 gpa_scale은 함께 입력하거나 모두 null. 0 <= gpa <= gpa_scale. 시작월 <= 종료월."
  checks {
    `(gpa IS NULL) = (gpa_scale IS NULL)`
    `gpa IS NULL OR (gpa >= 0 AND gpa <= gpa_scale)`
    `gpa_scale IS NULL OR gpa_scale IN (4.0, 4.3, 4.5, 5.0, 100.0)`
    `start_month IS NULL OR end_month IS NULL OR start_month <= end_month`
    `education_status IN ('ENROLLED','ON_LEAVE','EXPECTED_GRADUATION','GRADUATED')`
  }
}

Table courses {
  id bigint [pk, increment]
  education_id bigint [not null]
  major_name varchar(100)
  study_year smallint
  semester varchar(30)
  subject_name varchar(150) [not null]
  subject_type varchar(20) [not null, default: 'OTHER', note: 'Allowed: MAJOR, GENERAL, OTHER']
  credits decimal(4,1)
  grade varchar(10)
  retaken boolean [not null, default: false]
  position int [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    education_id
    (education_id, position) [unique]
  }
  checks {
    `study_year IS NULL OR study_year BETWEEN 1900 AND 2100`
    `semester IS NULL OR semester IN ('FIRST_SEMESTER','SECOND_SEMESTER','SUMMER','WINTER')`
    `subject_type IN ('MAJOR','GENERAL','OTHER')`
    `credits IS NULL OR (credits >= 0 AND credits <= 30)`
    `position BETWEEN 1 AND 1000`
  }
  Note: '학력별 수강 과목. position 오름차순으로 표시하며 학력 삭제 시 함께 삭제한다.'
}

Table certifications {
  id bigint [pk, increment]
  user_id bigint [not null]
  name varchar(100) [not null]
  issuer varchar(100)
  acquired_on date
  certificate_number varchar(100)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    user_id
  }
}

Table language_scores {
  id bigint [pk, increment]
  user_id bigint [not null]
  test_name varchar(100) [not null]
  score_or_grade varchar(50) [not null]
  tested_on date
  expires_on date
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    user_id
  }
  Note: "응시일 <= 유효기간. 점수와 등급은 문자열로 보관."
  checks {
    `tested_on IS NULL OR expires_on IS NULL OR tested_on <= expires_on`
  }
}

Table careers {
  id bigint [pk, increment]
  user_id bigint [not null]
  company_name varchar(100) [not null]
  employment_type varchar(30) [not null, note: "Allowed: INTERN, FULL_TIME, CONTRACT, PART_TIME, OTHER"]
  department varchar(100)
  job_title varchar(100)
  start_month char(7)
  end_month char(7)
  is_current boolean [not null]
  duties text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    user_id
  }
  Note: "재직 중이면 종료월 null. 경력 삭제 시 경험 career_id만 SET NULL."
  checks {
    `NOT is_current OR end_month IS NULL`
    `start_month IS NULL OR end_month IS NULL OR start_month <= end_month`
    `employment_type IN ('INTERN','FULL_TIME','CONTRACT','PART_TIME','OTHER')`
  }
}

Table experiences {
  id bigint [pk, increment]
  user_id bigint [not null]
  title varchar(150) [not null]
  activity_type varchar(50) [not null]
  start_month char(7)
  end_month char(7)
  career_id bigint
  situation text
  action text
  result text
  lesson text
  collaboration_memo text
  overview text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    user_id
  }
  Note: "career_id는 본인 경력만 허용. 제목과 유형 외 서술은 null 가능."
  checks {
    `start_month IS NULL OR end_month IS NULL OR start_month <= end_month`
  }
}

Table tags {
  id bigint [pk, increment]
  user_id bigint [not null]
  name varchar(30) [not null]
  indexes {
    (user_id, name) [unique]
  }
  Note: '양끝 공백 제거 후 같은 사용자 내 이름 중복 금지. 대소문자는 구분.'
}
Table experience_tags {
  experience_id bigint [not null]
  tag_id bigint [not null]
  indexes {
    (experience_id, tag_id) [pk]
    tag_id
  }
}

Table applications {
  id bigint [pk, increment]
  user_id bigint [not null]
  company_name varchar(100) [not null]
  job_title varchar(100) [not null]
  application_period varchar(100) [not null]
  status varchar(30) [not null, note: "Allowed: DRAFT, COMPLETED, SUBMITTED"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    user_id
  }
  Note: "회사/직무/시기 조합 중복 허용. 상태는 DRAFT ↔ COMPLETED ↔ SUBMITTED 순서로 전환하며 실제 외부 제출 여부가 아니라 사용자 관리용 표시다."
  checks {
    `status IN ('DRAFT','COMPLETED','SUBMITTED')`
  }
}

Table essay_questions {
  id bigint [pk, increment]
  application_id bigint [not null]
  prompt varchar(2000) [not null, default: '']
  answer text [not null, default: '']
  character_limit int [not null, default: 700]
  position int [not null]
  completion_status varchar(30) [not null, default: 'DRAFT', note: 'Allowed: DRAFT, COMPLETED']
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (application_id, position) [unique]
  }
  checks {
    `character_limit >= 1 AND character_limit <= 20000`
    `position >= 1 AND position <= 1000`
    `char_length(answer) <= 30000`
    `completion_status IN ('DRAFT','COMPLETED')`
    `(completion_status = 'COMPLETED') = (completed_at IS NOT NULL)`
  }
  Note: '초안은 문항/답변 공백 허용. 제한 초과도 30000자 이내 저장 허용. 완료는 명시적 사용자 동작이며 답변 수정 시 DRAFT로 돌아간다.'
}

Table question_versions {
  id bigint [pk, increment]
  question_id bigint [not null]
  version_number int [not null]
  version_kind varchar(30) [not null, note: 'Allowed: MANUAL, COMPLETED, SUBMITTED']
  prompt varchar(2000) [not null]
  answer text [not null]
  character_limit int [not null]
  experience_ids jsonb [not null, default: '[]']
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (question_id, version_number) [unique]
    (question_id, created_at)
  }
  checks {
    `version_number >= 1`
    `version_kind IN ('MANUAL','COMPLETED','SUBMITTED')`
    `character_limit >= 1 AND character_limit <= 20000`
    `char_length(answer) <= 30000`
  }
  Note: '자동 저장은 버전을 만들지 않는다. DRAFT는 제출 버전 1개와 최근 작업 버전 20개, COMPLETED는 제출 버전 1개·완료 버전·최근 작업 버전 5개, SUBMITTED는 최종 제출 버전 1개만 보관한다.'
}
Table question_experiences {
  question_id bigint [not null]
  experience_id bigint [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (question_id, experience_id) [pk]
    experience_id
  }
  Note: '같은 사용자 소유인지 서비스에서 검증. 경험을 삭제해도 답변은 유지.'
}

Table review_requests {
  id bigint [pk, increment]
  application_id bigint [not null]
  requester_id bigint [not null]
  reviewer_id bigint [not null]
  status varchar(30) [not null, default: 'REQUESTED', note: 'Allowed: REQUESTED, COMPLETED']
  requested_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
  indexes {
    application_id
    (requester_id, requested_at)
    (reviewer_id, status, requested_at)
  }
  checks {
    `requester_id <> reviewer_id`
    `status IN ('REQUESTED','COMPLETED')`
    `(status = 'COMPLETED') = (completed_at IS NOT NULL)`
  }
  Note: '작성 완료 자소서만 요청 가능. requester_id는 자소서 소유자와 같아야 하며 같은 자소서·검토자의 REQUESTED 요청 중복은 서비스에서 방지한다.'
}

Table review_comments {
  id bigint [pk, increment]
  review_request_id bigint [not null]
  question_id bigint [not null]
  author_id bigint [not null]
  content varchar(5000) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (review_request_id, question_id, author_id) [unique]
    question_id
  }
  checks {
    `char_length(btrim(content)) >= 1`
  }
  Note: '검토자는 문항별 메모 1개를 작성·수정한다. 자소서 본문 수정 권한은 없으며 COMPLETED 요청의 메모만 작성자 자료 서랍에 노출한다.'
}

Ref: users.id - profiles.user_id [delete: cascade]
Ref: educations.user_id > users.id [delete: cascade]
Ref: courses.education_id > educations.id [delete: cascade]
Ref: certifications.user_id > users.id [delete: cascade]
Ref: language_scores.user_id > users.id [delete: cascade]
Ref: careers.user_id > users.id [delete: cascade]
Ref: experiences.user_id > users.id [delete: cascade]
Ref: experiences.career_id > careers.id [delete: set null]
Ref: tags.user_id > users.id [delete: cascade]
Ref: experience_tags.experience_id > experiences.id [delete: cascade]
Ref: experience_tags.tag_id > tags.id [delete: cascade]
Ref: applications.user_id > users.id [delete: cascade]
Ref: essay_questions.application_id > applications.id [delete: cascade]
Ref: question_versions.question_id > essay_questions.id [delete: cascade]
Ref: question_experiences.question_id > essay_questions.id [delete: cascade]
Ref: question_experiences.experience_id > experiences.id [delete: cascade]
Ref: review_requests.application_id > applications.id [delete: cascade]
Ref: review_requests.requester_id > users.id [delete: cascade]
Ref: review_requests.reviewer_id > users.id [delete: cascade]
Ref: review_comments.review_request_id > review_requests.id [delete: cascade]
Ref: review_comments.question_id > essay_questions.id [delete: cascade]
Ref: review_comments.author_id > users.id [delete: cascade]
